<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="grobot">
  <xacro:arg name="base_diameter" default="0.505"/>
  <xacro:arg name="base_height" default="0.30"/>
  <xacro:arg name="wheel_radius" default="0.08625"/>
  <xacro:arg name="wheel_width" default="0.045"/>
  <xacro:arg name="track_width" default="0.375"/>
  <xacro:arg name="lidar_x" default="0.18"/>
  <xacro:arg name="lidar_y" default="0.0"/>
  <xacro:arg name="lidar_z" default="0.05"/>
  <xacro:arg name="lidar_yaw" default="0.0"/>
  <xacro:arg name="imu_x" default="0.0"/>
  <xacro:arg name="imu_y" default="0.0"/>
  <xacro:arg name="imu_z" default="0.10"/>
  <xacro:arg name="imu_roll" default="0.0"/>
  <xacro:arg name="imu_pitch" default="0.0"/>
  <xacro:arg name="imu_yaw" default="0.0"/>

  <xacro:property name="base_diameter" value="${float('$(arg base_diameter)')}"/>
  <xacro:property name="base_radius" value="${base_diameter / 2.0}"/>
  <xacro:property name="base_height" value="${float('$(arg base_height)')}"/>
  <xacro:property name="wheel_radius" value="${float('$(arg wheel_radius)')}"/>
  <xacro:property name="wheel_width" value="${float('$(arg wheel_width)')}"/>
  <xacro:property name="track_width" value="${float('$(arg track_width)')}"/>
  <xacro:property name="lidar_x" value="${float('$(arg lidar_x)')}"/>
  <xacro:property name="lidar_y" value="${float('$(arg lidar_y)')}"/>
  <xacro:property name="lidar_z" value="${float('$(arg lidar_z)')}"/>
  <xacro:property name="lidar_yaw" value="${float('$(arg lidar_yaw)')}"/>
  <xacro:property name="imu_x" value="${float('$(arg imu_x)')}"/>
  <xacro:property name="imu_y" value="${float('$(arg imu_y)')}"/>
  <xacro:property name="imu_z" value="${float('$(arg imu_z)')}"/>
  <xacro:property name="imu_roll" value="${float('$(arg imu_roll)')}"/>
  <xacro:property name="imu_pitch" value="${float('$(arg imu_pitch)')}"/>
  <xacro:property name="imu_yaw" value="${float('$(arg imu_yaw)')}"/>

  <material name="body_gray">
    <color rgba="0.35 0.38 0.42 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>
  <material name="lidar_blue">
    <color rgba="0.05 0.25 0.75 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${track_width / 2.0} 0" rpy="0 0 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-track_width / 2.0} 0" rpy="0 0 0"/>
  </joint>

  <link name="scan">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="scan"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>
</robot>
